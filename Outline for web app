```jsx name=src/pages/Lesson.jsx
import React, { useEffect, useState } from 'react';
import { useParams } from 'react-router-dom';
import { marked } from 'marked';
import SolarCanvas from '../visuals/SolarCanvas';

export default function Lesson() {
  const { slug } = useParams();
  const [contentHtml, setContentHtml] = useState('');

  useEffect(() => {
    // Example: load markdown from /lessons/<slug>.md in public
    fetch(`/lessons/${slug}.md`)
      .then(r => r.text())
      .then(md => setContentHtml(marked(md)))
      .catch(() => setContentHtml('# Lesson not found'));
  }, [slug]);

  return (
    <div>
      <article dangerouslySetInnerHTML={{ __html: contentHtml }} />
      <aside>
        <h3>Interactive</h3>
        <SolarCanvas />
      </aside>
    </div>
  );
}
```

